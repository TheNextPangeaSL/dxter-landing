---
/**
 * WorkflowInfographic.astro
 * Replaces the static infographic PNG with a fully animated HTML/CSS version.
 * Shows the 5-step DxTER experimental workflow in a circular layout.
 */
---

<div
    class="workflow-infographic"
    aria-label="Create your experimental project with DxTER"
>
    <!-- SVG connections layer — arcs + arrows between steps -->
    <svg
        class="wf-connections"
        viewBox="0 0 600 600"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
    >
        <!-- Faint circular guide -->
        <circle
            cx="300"
            cy="280"
            r="160"
            stroke="#d5f5f3"
            stroke-width="1.5"
            stroke-dasharray="5 4"
            opacity="0.5"></circle>

        <!-- Arc: Step 1 (top) → Step 2 (right) — DxTER teal -->
        <path
            d="M 370 140 A 160 160 0 0 1 440 240"
            stroke="url(#tealGrad)"
            stroke-width="2.5"
            stroke-linecap="round"
            class="wf-arc wf-arc-1"></path>
        <polygon
            points="443,243 433,233 437,247"
            fill="#7ad8d5"
            class="wf-arrow wf-arrow-1"></polygon>

        <!-- Arc: Step 2 (right) → Step 3 (bottom-right) — DxTER teal -->
        <path
            d="M 450 320 A 160 160 0 0 1 380 420"
            stroke="url(#tealGrad)"
            stroke-width="2.5"
            stroke-linecap="round"
            class="wf-arc wf-arc-2"></path>
        <polygon
            points="377,422 385,410 373,414"
            fill="#7ad8d5"
            class="wf-arrow wf-arrow-2"></polygon>

        <!-- Arc: Step 3 (bottom-right) → Step 4 (bottom-left) — DxTER teal -->
        <path
            d="M 280 440 A 160 160 0 0 1 195 405"
            stroke="url(#tealGrad)"
            stroke-width="2.5"
            stroke-linecap="round"
            class="wf-arc wf-arc-3"></path>
        <polygon
            points="192,403 202,410 198,396"
            fill="#7ad8d5"
            class="wf-arrow wf-arrow-3"></polygon>

        <!-- Arc: Step 4 (bottom-left) → Step 5 (left) — Lab green -->
        <path
            d="M 148 340 A 160 160 0 0 1 148 220"
            stroke="url(#greenGrad)"
            stroke-width="2.5"
            stroke-linecap="round"
            class="wf-arc wf-arc-4"></path>
        <polygon
            points="149,217 141,229 155,227"
            fill="#8cc63f"
            class="wf-arrow wf-arrow-4"></polygon>

        <!-- Arc: Step 5 (left) → Step 1 (top) — Lab green -->
        <path
            d="M 185 155 A 160 160 0 0 1 280 120"
            stroke="url(#greenGrad)"
            stroke-width="2.5"
            stroke-linecap="round"
            class="wf-arc wf-arc-5"></path>
        <polygon
            points="283,118 271,112 273,126"
            fill="#8cc63f"
            class="wf-arrow wf-arrow-5"></polygon>

        <defs>
            <linearGradient id="tealGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#aeeae7"></stop>
                <stop offset="100%" stop-color="#7ad8d5"></stop>
            </linearGradient>
            <linearGradient id="greenGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#a8d86a"></stop>
                <stop offset="100%" stop-color="#8cc63f"></stop>
            </linearGradient>
        </defs>
    </svg>

    <!-- Central hub -->
    <div class="wf-center">
        <div class="wf-center-ring"></div>
        <div class="wf-center-ring wf-center-ring-2"></div>
        <div class="wf-center-icon">
            <svg
                viewBox="0 0 64 64"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                class="wf-logo-svg"
            >
                <circle
                    cx="32"
                    cy="32"
                    r="28"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-dasharray="4 3"
                    opacity="0.15"></circle>
                <path
                    d="M26 18V26L18 42C17 44 18.5 46 21 46H43C45.5 46 47 44 46 42L38 26V18"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                <path
                    d="M24 18H40"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"></path>
                <rect
                    x="27"
                    y="34"
                    width="3"
                    height="8"
                    rx="1"
                    fill="#4abfbd"
                    opacity="0.9"></rect>
                <rect x="31" y="31" width="3" height="11" rx="1" fill="#177b7d"
                ></rect>
                <rect
                    x="35"
                    y="33"
                    width="3"
                    height="9"
                    rx="1"
                    fill="#4abfbd"
                    opacity="0.9"></rect>
                <circle cx="44" cy="16" r="1.5" fill="#177b7d"></circle>
                <path
                    d="M44 12V14M44 18V20M40 16H42M46 16H48"
                    stroke="#177b7d"
                    stroke-width="1"
                    stroke-linecap="round"></path>
            </svg>
        </div>
    </div>

    <!-- Step 01 — Initialize (top) -->
    <div class="wf-step wf-step-1" style="--step-delay: 0.15s">
        <div class="wf-step-icon wf-bob-1">
            <svg
                viewBox="0 0 40 40"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
            >
                <rect
                    x="6"
                    y="10"
                    width="18"
                    height="22"
                    rx="2"
                    stroke="#555"
                    stroke-width="1.5"></rect>
                <path
                    d="M10 16H20M10 20H20M10 24H16"
                    stroke="#555"
                    stroke-width="1.2"
                    stroke-linecap="round"></path>
                <rect
                    x="19"
                    y="5"
                    width="14"
                    height="12"
                    rx="2"
                    stroke="#888"
                    stroke-width="1.2"
                    fill="white"></rect>
                <path
                    d="M22 9H30M22 12H27"
                    stroke="#aaa"
                    stroke-width="1"
                    stroke-linecap="round"></path>
                <path
                    d="M26 1V3.5M28.5 2L27.5 3.5M23.5 2L24.5 3.5"
                    stroke="#e8a030"
                    stroke-width="1"
                    stroke-linecap="round"></path>
                <path
                    d="M17 32L17 37M20 32L20 37"
                    stroke="#177b7d"
                    stroke-width="1.8"
                    stroke-linecap="round"></path>
            </svg>
        </div>
        <div class="wf-step-content">
            <span class="wf-step-number">01</span>
            <span class="wf-step-title">Initialize</span>
            <p class="wf-step-desc">
                Upload to DxTER the results of your experiments.
            </p>
            <div class="wf-step-bar wf-bar-teal"></div>
        </div>
    </div>

    <!-- Step 02 — Configure (right) -->
    <div class="wf-step wf-step-2" style="--step-delay: 0.3s">
        <div class="wf-step-icon wf-bob-2">
            <svg
                viewBox="0 0 40 40"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
            >
                <rect
                    x="9"
                    y="5"
                    width="20"
                    height="30"
                    rx="2"
                    stroke="#555"
                    stroke-width="1.5"></rect>
                <path
                    d="M13 11H25M13 15H25M13 19H25M13 23H20"
                    stroke="#555"
                    stroke-width="1.1"
                    stroke-linecap="round"></path>
                <circle
                    cx="30"
                    cy="28"
                    r="6"
                    stroke="#177b7d"
                    stroke-width="1.5"
                    fill="white"></circle>
                <path
                    d="M28 28L30 30L33 26"
                    stroke="#177b7d"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
            </svg>
        </div>
        <div class="wf-step-content">
            <span class="wf-step-number">02</span>
            <span class="wf-step-title">Configure</span>
            <p class="wf-step-desc">
                Define the structure of your dataset: factors & responses.
            </p>
            <div class="wf-step-bar wf-bar-teal"></div>
        </div>
    </div>

    <!-- Step 03 — Design (bottom-right) -->
    <div class="wf-step wf-step-3" style="--step-delay: 0.45s">
        <div class="wf-step-icon wf-bob-3">
            <svg
                viewBox="0 0 40 40"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
            >
                <circle cx="20" cy="20" r="13" stroke="#555" stroke-width="1.5"
                ></circle>
                <circle
                    cx="20"
                    cy="20"
                    r="8"
                    stroke="#e8a030"
                    stroke-width="1.5"></circle>
                <circle cx="20" cy="20" r="3" fill="#e8a030"></circle>
                <path
                    d="M31 11L35 7M35 7L33 7M35 7L35 9"
                    stroke="#555"
                    stroke-width="1.3"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
            </svg>
        </div>
        <div class="wf-step-content">
            <span class="wf-step-number">03</span>
            <span class="wf-step-title">Design</span>
            <p class="wf-step-desc">
                Configure your Design of Experiment (DOE) and select your
                objectives.
            </p>
            <div class="wf-step-bar wf-bar-teal"></div>
        </div>
    </div>

    <!-- Step 04 — Predict (bottom-left) -->
    <div class="wf-step wf-step-4" style="--step-delay: 0.6s">
        <div class="wf-step-icon wf-bob-4">
            <svg
                viewBox="0 0 40 40"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
            >
                <circle
                    cx="12"
                    cy="14"
                    r="7"
                    stroke="#aaa"
                    stroke-width="1.3"
                    fill="none"></circle>
                <path
                    d="M9.5 14 A2.5 2.5 0 0 1 14.5 14"
                    stroke="#e8a030"
                    stroke-width="0.8"
                    fill="none"></path>
                <path
                    d="M10 21H14M10.5 23H13.5"
                    stroke="#aaa"
                    stroke-width="1"
                    stroke-linecap="round"></path>
                <path
                    d="M19 16H22M24 16H27"
                    stroke="#888"
                    stroke-width="1"
                    stroke-linecap="round"
                    stroke-dasharray="2 2"></path>
                <rect
                    x="24"
                    y="9"
                    width="13"
                    height="11"
                    rx="2"
                    stroke="#555"
                    stroke-width="1.3"></rect>
                <path
                    d="M27 13H34M27 17H32"
                    stroke="#ccc"
                    stroke-width="0.9"
                    stroke-linecap="round"></path>
                <path
                    d="M30.5 20V24M27 24H34"
                    stroke="#555"
                    stroke-width="1"
                    stroke-linecap="round"></path>
            </svg>
        </div>
        <div class="wf-step-content">
            <span class="wf-step-number">04</span>
            <span class="wf-step-title">Predict</span>
            <p class="wf-step-desc">
                Ask DxTER for experiment recommendations: factor settings.
            </p>
            <div class="wf-step-bar wf-bar-blue"></div>
        </div>
    </div>

    <!-- Step 05 — Execute (left) -->
    <div class="wf-step wf-step-5" style="--step-delay: 0.75s">
        <div class="wf-step-icon wf-bob-5">
            <svg
                viewBox="0 0 40 40"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
            >
                <path
                    d="M14 7H22V16L27 32C27.5 34 26 36 24 36H12C10 36 8.5 34 9 32L14 16V7Z"
                    stroke="#555"
                    stroke-width="1.5"
                    stroke-linejoin="round"></path>
                <path
                    d="M12 7H24"
                    stroke="#555"
                    stroke-width="1.5"
                    stroke-linecap="round"></path>
                <path
                    d="M11.5 25H24.5L27 32C27.3 33 26.2 35 24 35H12C9.8 35 8.7 33 9 32L11.5 25Z"
                    fill="#e8a030"
                    opacity="0.25"></path>
                <path
                    d="M30 7V36M28 7H32M26 36H34"
                    stroke="#777"
                    stroke-width="1.2"
                    stroke-linecap="round"></path>
                <circle
                    cx="16"
                    cy="29"
                    r="1.2"
                    fill="#e8a030"
                    opacity="0.6"
                    class="wf-bubble-1"></circle>
                <circle
                    cx="19.5"
                    cy="27"
                    r="0.9"
                    fill="#e8a030"
                    opacity="0.5"
                    class="wf-bubble-2"></circle>
                <circle
                    cx="17.5"
                    cy="31.5"
                    r="0.7"
                    fill="#e8a030"
                    opacity="0.4"
                    class="wf-bubble-3"></circle>
            </svg>
        </div>
        <div class="wf-step-content">
            <span class="wf-step-number">05</span>
            <span class="wf-step-title">Execute</span>
            <p class="wf-step-desc">Conduct the proposed experiments.</p>
            <div class="wf-step-bar wf-bar-green"></div>
        </div>
    </div>

    <!-- Legend -->
    <div class="wf-legend">
        <span class="wf-legend-item"
            ><span class="wf-legend-dot wf-dot-teal"></span> DxTER</span
        >
        <span class="wf-legend-item"
            ><span class="wf-legend-dot wf-dot-green"></span> Lab</span
        >
    </div>
</div>

<style>
    /* ─── Container ─── */
    .workflow-infographic {
        position: relative;
        width: 100%;
        max-width: 560px;
        aspect-ratio: 1 / 1.08;
        margin: 0 auto;
        font-family: var(--font-sans, "Rubik", system-ui, sans-serif);
        user-select: none;
    }

    /* ─── SVG arcs layer ─── */
    .wf-connections {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 1;
        pointer-events: none;
    }

    .wf-arc {
        stroke-dasharray: 250;
        stroke-dashoffset: 250;
        animation: wf-draw 0.9s ease-out forwards;
    }
    .wf-arc-1 {
        animation-delay: 0.6s;
    }
    .wf-arc-2 {
        animation-delay: 0.85s;
    }
    .wf-arc-3 {
        animation-delay: 1.1s;
    }
    .wf-arc-4 {
        animation-delay: 1.35s;
    }
    .wf-arc-5 {
        animation-delay: 1.6s;
    }

    .wf-arrow {
        opacity: 0;
        animation: wf-pop 0.3s ease-out forwards;
    }
    .wf-arrow-1 {
        animation-delay: 1.35s;
    }
    .wf-arrow-2 {
        animation-delay: 1.6s;
    }
    .wf-arrow-3 {
        animation-delay: 1.85s;
    }
    .wf-arrow-4 {
        animation-delay: 2.1s;
    }
    .wf-arrow-5 {
        animation-delay: 2.35s;
    }

    /* ─── Central hub ─── */
    .wf-center {
        position: absolute;
        top: 44%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 10;
    }

    .wf-center-ring {
        position: absolute;
        inset: -22px;
        border-radius: 50%;
        border: 2px solid rgba(23, 123, 125, 0.08);
        animation: wf-ring-pulse 5s ease-in-out infinite;
    }

    .wf-center-ring-2 {
        inset: -38px;
        border-color: rgba(23, 123, 125, 0.04);
        animation-delay: 1.5s;
    }

    .wf-center-icon {
        width: 96px;
        height: 96px;
        background: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow:
            0 6px 30px rgba(23, 123, 125, 0.12),
            0 0 0 4px rgba(23, 123, 125, 0.05);
        opacity: 0;
        transform: scale(0.6);
        animation: wf-scale-in 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) 0.1s
            forwards;
    }

    .wf-logo-svg {
        width: 54px;
        height: 54px;
        color: #177b7d;
    }

    /* ─── Steps ─── */
    .wf-step {
        position: absolute;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        z-index: 5;
        opacity: 0;
        transform: translateY(18px) scale(0.92);
        animation: wf-step-in 0.55s ease-out forwards;
        animation-delay: var(--step-delay, 0s);
    }

    /*
   * Positions: 5 steps around the circle.
   * The SVG viewBox is 600×600, circle center at (300,280) r=160.
   * We place HTML elements to match.
   */

    /* 01 Initialize — top, to the right of center */
    .wf-step-1 {
        top: 5%;
        left: 52%;
    }

    /* 02 Configure — right side */
    .wf-step-2 {
        top: 34%;
        right: -2%;
    }

    /* 03 Design — bottom-right */
    .wf-step-3 {
        bottom: 18%;
        right: 2%;
    }

    /* 04 Predict — bottom-left */
    .wf-step-4 {
        bottom: 14%;
        left: 0%;
    }

    /* 05 Execute — left side */
    .wf-step-5 {
        top: 26%;
        left: -2%;
    }

    /* Step icon bubble */
    .wf-step-icon {
        width: 54px;
        height: 54px;
        min-width: 54px;
        background: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow:
            0 2px 14px rgba(0, 0, 0, 0.07),
            0 0 0 2.5px rgba(229, 231, 235, 0.7);
        transition:
            transform 0.35s ease,
            box-shadow 0.35s ease;
        will-change: transform;
    }

    .wf-step:hover .wf-step-icon {
        transform: scale(1.12);
        box-shadow:
            0 6px 24px rgba(23, 123, 125, 0.18),
            0 0 0 2.5px rgba(23, 123, 125, 0.25);
    }

    .wf-step-icon svg {
        width: 34px;
        height: 34px;
    }

    /* Step text */
    .wf-step-content {
        max-width: 155px;
        padding-top: 2px;
    }

    .wf-step-number {
        font-size: 1.35rem;
        font-weight: 800;
        color: #177b7d;
        line-height: 1;
        margin-right: 3px;
        letter-spacing: -0.02em;
    }

    .wf-step-title {
        font-size: 0.82rem;
        font-weight: 700;
        color: #1e293b;
        letter-spacing: 0.01em;
    }

    .wf-step-desc {
        font-size: 0.68rem;
        color: #64748b;
        line-height: 1.5;
        margin-top: 3px;
        margin-bottom: 0;
    }

    /* Colored accent bar */
    .wf-step-bar {
        width: 38px;
        height: 4px;
        border-radius: 2px;
        margin-top: 7px;
        transform-origin: left center;
        transform: scaleX(0);
        animation: wf-bar-grow 0.45s ease-out forwards;
        animation-delay: calc(var(--step-delay, 0s) + 0.55s);
    }

    .wf-bar-teal {
        background: linear-gradient(90deg, #7ad8d5, #aeeae7);
    }
    .wf-bar-blue {
        background: linear-gradient(90deg, #177b7d, #4abfbd);
    }
    .wf-bar-green {
        background: linear-gradient(90deg, #8cc63f, #b5e472);
    }

    /* ─── Legend ─── */
    .wf-legend {
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 22px;
        opacity: 0;
        animation: wf-fade 0.5s ease-out 2.5s forwards;
    }

    .wf-legend-item {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.72rem;
        color: #64748b;
        font-weight: 500;
    }

    .wf-legend-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

    .wf-dot-teal {
        background: #4abfbd;
    }
    .wf-dot-green {
        background: #8cc63f;
    }

    /* ─── Bobbing animation per icon ─── */
    .wf-bob-1 {
        animation: wf-bob 7s ease-in-out 1s infinite;
    }
    .wf-bob-2 {
        animation: wf-bob 7s ease-in-out 2.2s infinite;
    }
    .wf-bob-3 {
        animation: wf-bob 7s ease-in-out 3.4s infinite;
    }
    .wf-bob-4 {
        animation: wf-bob 7s ease-in-out 4.6s infinite;
    }
    .wf-bob-5 {
        animation: wf-bob 7s ease-in-out 5.8s infinite;
    }

    /* ─── Flask bubbles ─── */
    .wf-bubble-1 {
        animation: wf-bubble 3s ease-in-out 1s infinite;
    }
    .wf-bubble-2 {
        animation: wf-bubble 3s ease-in-out 2s infinite;
    }
    .wf-bubble-3 {
        animation: wf-bubble 3s ease-in-out 2.5s infinite;
    }

    /* ─── Keyframes ─── */
    @keyframes wf-draw {
        to {
            stroke-dashoffset: 0;
        }
    }

    @keyframes wf-pop {
        from {
            opacity: 0;
            transform: scale(0.5);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    @keyframes wf-scale-in {
        from {
            opacity: 0;
            transform: scale(0.6);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    @keyframes wf-step-in {
        from {
            opacity: 0;
            transform: translateY(18px) scale(0.92);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @keyframes wf-bar-grow {
        from {
            transform: scaleX(0);
        }
        to {
            transform: scaleX(1);
        }
    }

    @keyframes wf-fade {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    @keyframes wf-ring-pulse {
        0%,
        100% {
            transform: scale(1);
            opacity: 0.5;
        }
        50% {
            transform: scale(1.18);
            opacity: 0.1;
        }
    }

    @keyframes wf-bob {
        0%,
        100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-7px);
        }
    }

    @keyframes wf-bubble {
        0%,
        100% {
            opacity: 0.3;
            transform: translateY(0);
        }
        50% {
            opacity: 0.7;
            transform: translateY(-2px);
        }
    }

    /* ─── Responsive ─── */
    @media (max-width: 1280px) {
        .workflow-infographic {
            max-width: 480px;
        }
    }

    @media (max-width: 1024px) {
        .workflow-infographic {
            max-width: 420px;
        }

        .wf-center-icon {
            width: 80px;
            height: 80px;
        }

        .wf-logo-svg {
            width: 46px;
            height: 46px;
        }

        .wf-step-icon {
            width: 46px;
            height: 46px;
            min-width: 46px;
        }

        .wf-step-icon svg {
            width: 28px;
            height: 28px;
        }

        .wf-step-content {
            max-width: 130px;
        }

        .wf-step-number {
            font-size: 1.15rem;
        }

        .wf-step-title {
