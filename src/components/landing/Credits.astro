---
import Icon from "./Icon.astro";
import type { Dict } from "@/i18n/es";

interface Props {
    t: Dict["credits"];
}

const { t } = Astro.props;
const base = import.meta.env.BASE_URL;
const levelKeys = ["low", "medium", "high"];
---

<section id="creditos" data-slide class="slide relative overflow-hidden bg-soft">
    <div class="mx-auto max-w-[1240px] px-5 sm:px-8">
        <div class="mx-auto max-w-[820px] text-center">
            <span class="eyebrow reveal">{t.eyebrow}</span>
            <h2 class="h-display reveal mt-5 text-[clamp(2.1rem,4vw,3.2rem)] text-ink">
                {t.title} <span class="text-gradient">{t.titleAccent}</span>
            </h2>
        </div>

        <div class="mt-8 grid gap-4 lg:grid-cols-[1.35fr_1fr]">
            <!-- Complexity explorer -->
            <div class="card reveal overflow-hidden p-6 sm:p-8">
                <h3 class="font-display text-2xl font-semibold tracking-tight text-ink">{t.payTitle}</h3>
                <p class="mt-3 max-w-[620px] text-[15px] leading-relaxed text-muted">
                    {t.payText}
                </p>

                <div class="mt-6 inline-grid grid-cols-3 gap-1 rounded-full bg-soft p-1 ring-1 ring-line" role="tablist" aria-label={t.tabsAria}>
                    {
                        t.levels.map((l, i) => (
                            <button
                                type="button"
                                role="tab"
                                id={`credit-tab-${levelKeys[i]}`}
                                aria-controls={`credit-panel-${levelKeys[i]}`}
                                aria-selected={i === 0 ? "true" : "false"}
                                data-credit-tab={i}
                                class="seg-btn rounded-full px-4 py-2 text-sm font-medium text-muted sm:px-6"
                            >
                                {l.label}
                            </button>
                        ))
                    }
                </div>

                <div class="relative mt-5">
                    {
                        t.levels.map((l, i) => (
                            <div
                                id={`credit-panel-${levelKeys[i]}`}
                                role="tabpanel"
                                aria-labelledby={`credit-tab-${levelKeys[i]}`}
                                data-credit-panel={i}
                                hidden={i !== 0}
                                class="grid items-center gap-6 sm:grid-cols-[1fr_1.2fr]"
                            >
                                <div>
                                    <div class="flex items-center gap-1.5" aria-hidden="true">
                                        {[0, 1, 2].map((b) => (
                                            <span class={`h-1.5 w-8 rounded-full ${b <= i ? "bg-teal" : "bg-line"}`} />
                                        ))}
                                    </div>
                                    <span class="mt-4 block font-mono text-xs uppercase tracking-[0.14em] text-muted">
                                        {l.heading}
                                    </span>
                                    <div class="mt-2 flex items-baseline gap-2">
                                        <span class="h-display text-7xl text-ink" data-credit-num>{i + 1}</span>
                                        <span class="text-lg text-muted">{l.unit}</span>
                                    </div>
                                    <div class="text-[15px] text-muted">{t.perRecommendation}</div>
                                    <ul class="mt-5 space-y-2">
                                        {l.points.map((p) => (
                                            <li class="flex items-start gap-2.5 text-[15px] text-ink-2">
                                                <Icon name="check" size={16} class="mt-0.5 shrink-0 text-teal" strokeWidth={2.4} />
                                                {p}
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                                <div class="rounded-3xl bg-gradient-to-b from-mint to-white p-2 [&_img]:mx-auto [&_img]:max-h-[min(200px,20vh)] [&_img]:w-auto">
                                    <img
                                        src={`${base}img/${levelKeys[i]}.webp`}
                                        alt=""
                                        width="820"
                                        height="615"
                                        loading="lazy"
                                        class="w-full"
                                    />
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>

            <div class="grid min-w-0 gap-3">
                <div class="dark-surface on-dark reveal relative overflow-hidden rounded-3xl p-5 sm:p-6">
                    <div class="flex items-center gap-3">
                        <span class="icon-tile !h-10 !w-10 !rounded-xl"><Icon name="coins" size={18} /></span>
                        <h3 class="font-display text-lg font-semibold tracking-tight text-white">{t.poolTitle}</h3>
                    </div>
                    <p class="mt-3 text-[14px] leading-relaxed text-white/65">{t.poolText}</p>
                </div>
                <div class="card reveal p-5 sm:p-6">
                    <div class="flex items-center gap-3">
                        <span class="icon-tile !h-10 !w-10 !rounded-xl"><Icon name="support" size={18} /></span>
                        <h3 class="font-display text-lg font-semibold tracking-tight text-ink">{t.supportTitle}</h3>
                    </div>
                    <p class="mt-3 text-[14px] leading-relaxed text-muted">{t.supportText}</p>
                </div>
                <div class="card reveal p-5 sm:p-6">
                    <h3 class="font-display text-lg font-semibold tracking-tight text-ink">{t.customTitle}</h3>
                    <p class="mt-2 text-[14px] leading-relaxed text-muted">{t.customText}</p>
                    <a href="#contacto" data-prefill="integration" class="btn btn-primary mt-4 !min-h-[42px] !px-5 !text-[14px]">
                        {t.customCta} <Icon name="arrow" size={16} strokeWidth={2} />
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    import { animate, stagger } from "animejs";

    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-credit-tab]"));
    const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-credit-panel]"));

    const select = (i: number, focus = false) => {
        tabs.forEach((t, j) => {
            t.setAttribute("aria-selected", String(i === j));
            t.tabIndex = i === j ? 0 : -1;
        });
        panels.forEach((p, j) => (p.hidden = i !== j));
        if (focus) tabs[i].focus();
        if (reduce) return;
        const panel = panels[i];
        animate(panel.querySelectorAll(":scope > div > *"), {
            opacity: [0, 1],
            x: [-16, 0],
            duration: 700,
            delay: stagger(50),
            ease: "outQuart",
        });
        animate(panel.querySelector("img")!, { opacity: [0, 1], scale: [0.94, 1], duration: 900, ease: "outExpo" });
        const num = panel.querySelector<HTMLElement>("[data-credit-num]");
        if (num) animate(num, { y: ["60%", "0%"], opacity: [0, 1], duration: 800, ease: "outExpo" });
    };

    tabs.forEach((t, i) => {
        t.addEventListener("click", () => select(i));
        t.addEventListener("keydown", (e) => {
            if (e.key === "ArrowRight") select((i + 1) % tabs.length, true);
            if (e.key === "ArrowLeft") select((i - 1 + tabs.length) % tabs.length, true);
        });
    });

</script>
