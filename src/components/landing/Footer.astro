---
import type { Dict } from "@/i18n/es";

interface Props {
    t: Dict["footer"];
}

const { t } = Astro.props;
const base = import.meta.env.BASE_URL;
const [copyBefore, copyAfter] = t.copyright.split("{company}");
---

<footer class="relative z-[1] overflow-hidden bg-abyss text-white">
    <div class="mx-auto max-w-[1240px] px-5 pt-16 sm:px-8">
        <div class="flex flex-col justify-between gap-12 md:flex-row">
            <div class="max-w-[340px]">
                <img src={`${base}img/dxter-logo-neg.png`} alt="DxTER" width="640" height="221" loading="lazy" class="h-14 w-auto" />
                <p class="mt-5 text-[15px] leading-relaxed text-white/55">{t.tagline}</p>
            </div>
            <div class="grid grid-cols-2 gap-16">
                <div>
                    <strong class="font-mono text-xs font-medium uppercase tracking-[0.14em] text-white/40">{t.product}</strong>
                    <ul class="mt-5 space-y-3 text-[15px]">
                        {t.productLinks.map((l) => <li><a href={l.href} class="text-white/70 transition-colors hover:text-white">{l.label}</a></li>)}
                    </ul>
                </div>
                <div>
                    <strong class="font-mono text-xs font-medium uppercase tracking-[0.14em] text-white/40">{t.legal}</strong>
                    <ul class="mt-5 space-y-3 text-[15px]">
                        {t.legalLinks.map((l) => <li><a href="#" class="text-white/70 transition-colors hover:text-white">{l}</a></li>)}
                    </ul>
                </div>
            </div>
        </div>

        <div class="mt-14 flex flex-col gap-3 border-t border-white/10 py-8 text-sm text-white/45 sm:flex-row sm:items-center sm:justify-between">
            <span>
                {copyBefore}<a href="https://thenextpangea.com/" target="_blank" rel="noopener noreferrer" class="text-white/70 underline underline-offset-2 hover:text-white">TheNextPangea</a>{copyAfter}
            </span>
            <span class="font-mono text-xs uppercase tracking-[0.14em]">{t.tagline}</span>
        </div>
    </div>
</footer>
