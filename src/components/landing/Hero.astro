---
import Icon from "./Icon.astro";
import type { Dict } from "@/i18n/es";

interface Props {
    t: Dict["hero"];
}

const { t } = Astro.props;
const proofIcons = ["rocket", "refresh", "shield"] as const;
---

<!-- The response surface behind this section is the fixed #scene canvas (src/scripts/scene.ts). -->
<header id="top" data-slide data-scene="hero" class="on-dark relative isolate flex min-h-[100svh] flex-col overflow-hidden text-white">
    <div class="scrim-left pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="relative mx-auto flex w-full max-w-[1240px] flex-1 items-center px-5 pb-16 pt-32 sm:px-8 lg:pb-24 lg:pt-36">
        <div class="max-w-[760px]">
            <div data-hero="badge" class="reveal inline-flex items-center gap-2.5 rounded-full border border-cyan/25 bg-cyan/[0.07] py-1.5 pl-2 pr-4 text-[13px] font-medium text-cyan backdrop-blur">
                <span class="grid h-6 w-6 place-items-center rounded-full bg-cyan/15"><Icon name="sparkles" size={14} /></span>
                {t.badge}
            </div>

            <h1 class="h-display reveal mt-7 text-[clamp(2.6rem,5.6vw,4.6rem)]">
                <span class="block text-white">{t.line1}</span>
                <span class="text-gradient-dark block pb-2">{t.line2}</span>
            </h1>

            <p data-hero="lead" class="reveal mt-6 max-w-[520px] text-lg leading-relaxed text-white/70 sm:text-xl">
                {t.lead}
            </p>

            <div data-hero="cta" class="mt-10 flex flex-wrap gap-3">
                <a href="#contacto" data-boom class="reveal btn btn-primary !min-h-[54px] !px-7 !text-base">
                    {t.cta} <Icon name="arrow" size={18} strokeWidth={2} />
                </a>
                <a href="#contacto" data-prefill="demo" class="reveal btn btn-ghost !min-h-[54px] !px-7 !text-base">
                    <Icon name="play" size={16} />
                    {t.demo}
                </a>
            </div>
        </div>

        <!-- Floating product chips (desktop) -->
        <div class="pointer-events-none absolute bottom-[16%] right-8 hidden xl:block" aria-hidden="true">
            <div data-hero="chip" class="glass-dark reveal w-[264px] p-4">
                <div class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.14em] text-cyan">
                    <span class="pulse-dot h-2 w-2 rounded-full bg-lime"></span>
                    {t.chipTitle}
                </div>
                <p class="mt-2 text-[13px] leading-snug text-white/70">{t.chipText}</p>
                <div class="mt-3 grid grid-cols-3 gap-1 rounded-xl bg-black/25 p-1 text-center text-[11px] font-medium">
                    {t.strategies.map((s, i) => <span class:list={["rounded-lg py-1.5", i === 1 ? "bg-cyan/15 text-cyan" : "text-white/50"]}>{s}</span>)}
                </div>
            </div>
        </div>
    </div>

    <!-- Proof strip -->
    <div class="relative border-t border-white/10 bg-navy-950/50 backdrop-blur-md">
        <div class="mx-auto grid max-w-[1240px] gap-px px-5 sm:grid-cols-3 sm:px-8">
            {
                t.proof.map((p, i) => (
                    <div data-hero="proof" class="reveal flex items-center gap-4 py-5 sm:py-7">
                        <span class="icon-tile !h-11 !w-11 !rounded-xl">
                            <Icon name={proofIcons[i]} size={20} />
                        </span>
                        <div>
                            <div class="font-display text-lg font-semibold tracking-tight text-white">
                                {p.title}
                                {"unit" in p && <span class="text-sm font-normal text-white/55"> {p.unit}</span>}
                            </div>
                            <div class="text-sm text-white/55">{p.note}</div>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</header>
