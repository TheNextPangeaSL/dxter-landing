---
import Icon from "./Icon.astro";
import type { Dict } from "@/i18n/es";

interface Props {
    t: Dict["nav"];
    lang: "es" | "en";
}

const { t, lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const langs = [
    { code: "es", href: base, label: "ES", aria: "Ver web en español" },
    { code: "en", href: `${base}en/`, label: "EN", aria: "View website in English" },
];
---

<nav
    id="site-nav"
    class="reveal site-nav fixed inset-x-0 top-0 z-50"
    aria-label={t.aria}
    data-open-label={t.openMenu}
    data-close-label={t.closeMenu}
>
    <div class="mx-auto flex h-[72px] max-w-[1240px] items-center justify-between gap-6 px-5 sm:px-8">
        <a href="#top" class="shrink-0" aria-label={t.home}>
            <img src={`${base}img/dxter-logo-noclaim-neg.png`} alt="DxTER" width="640" height="182" class="h-8 w-auto" />
        </a>

        <div class="hidden items-center gap-9 text-[15px] font-medium lg:flex">
            {t.links.map((l) => <a href={l.href} class="nav-link">{l.label}</a>)}
        </div>

        <div class="flex items-center gap-3">
            <div class="hidden items-center rounded-full border border-white/12 p-0.5 font-mono text-[11px] sm:flex" role="group" aria-label="Language">
                {
                    langs.map((l) => (
                        <a
                            href={l.href}
                            hreflang={l.code}
                            aria-label={l.aria}
                            aria-current={l.code === lang ? "page" : undefined}
                            class:list={[
                                "rounded-full px-2.5 py-1 transition-colors",
                                l.code === lang ? "bg-white/12 text-white" : "text-white/50 hover:text-white",
                            ]}
                        >
                            {l.label}
                        </a>
                    ))
                }
            </div>
            <a href="https://app.dxter.ai" class="hidden text-[15px] font-medium text-white/75 transition-colors hover:text-white md:inline">
                {t.login}
            </a>
            <a href="#contacto" data-boom class="btn btn-primary hidden !min-h-[42px] !px-5 !text-[14px] sm:inline-flex">
                {t.start}
            </a>
            <button
                id="nav-toggle"
                type="button"
                class="grid h-11 w-11 place-items-center rounded-full border border-white/15 text-white lg:hidden"
                aria-controls="mobile-panel"
                aria-expanded="false"
                aria-label={t.openMenu}
            >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <path class="nav-l1" d="M4 7h16"></path>
                    <path class="nav-l2" d="M4 17h16"></path>
                </svg>
            </button>
        </div>
    </div>

    <div
        id="mobile-panel"
        data-open="false"
        class="mobile-panel absolute inset-x-3 top-[76px] rounded-3xl border border-white/10 bg-navy-950/95 p-3 shadow-2xl backdrop-blur-xl lg:hidden"
    >
        {
            t.links.map((l) => (
                <a href={l.href} class="flex items-center justify-between rounded-2xl px-4 py-3.5 text-lg font-medium text-white/90 hover:bg-white/5">
                    {l.label}
                    <Icon name="arrow" size={18} class="text-cyan" />
                </a>
            ))
        }
        <div class="mt-2 flex items-center justify-end border-t border-white/10 px-4 pt-4 font-mono text-xs">
            <div class="flex gap-1" role="group" aria-label="Language">
                {
                    langs.map((l) => (
                        <a
                            href={l.href}
                            hreflang={l.code}
                            aria-label={l.aria}
                            class:list={["rounded-full px-3 py-1.5", l.code === lang ? "bg-white/12 text-white" : "text-white/50"]}
                        >
                            {l.label}
                        </a>
                    ))
                }
            </div>
        </div>
        <div class="mt-3 grid grid-cols-2 gap-2 p-2">
            <a href="https://app.dxter.ai" class="btn btn-ghost">{t.login}</a>
            <a href="#contacto" data-boom class="btn btn-primary">{t.start}</a>
        </div>
    </div>
</nav>

<script>
    const nav = document.getElementById("site-nav")!;
    const toggle = document.getElementById("nav-toggle")!;
    const panel = document.getElementById("mobile-panel")!;

    const onScroll = () => nav.classList.toggle("is-scrolled", window.scrollY > 24);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });

    const setOpen = (open: boolean) => {
        panel.dataset.open = String(open);
        toggle.setAttribute("aria-expanded", String(open));
        toggle.setAttribute("aria-label", (open ? nav.dataset.closeLabel : nav.dataset.openLabel) ?? "");
        nav.classList.toggle("is-scrolled", open || window.scrollY > 24);
        toggle.querySelector(".nav-l1")?.setAttribute("d", open ? "M6 6l12 12" : "M4 7h16");
        toggle.querySelector(".nav-l2")?.setAttribute("d", open ? "M6 18L18 6" : "M4 17h16");
    };
    toggle.addEventListener("click", () => setOpen(panel.dataset.open !== "true"));
    panel.querySelectorAll("a[href^='#']").forEach((a) => a.addEventListener("click", () => setOpen(false)));
    document.addEventListener("keydown", (e) => e.key === "Escape" && setOpen(false));
</script>
