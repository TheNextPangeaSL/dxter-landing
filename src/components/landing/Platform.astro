---
import Icon from "./Icon.astro";
import type { Dict } from "@/i18n/es";

interface Props {
    t: Dict["platform"];
}

const { t } = Astro.props;
const base = import.meta.env.BASE_URL;
const featureIcons = ["chart", "target", "trend", "list"] as const;
---

<!-- Scene: points circulate as a frame of light around the app window. -->
<section id="plataforma" data-slide data-scene="platform" data-scene-offset="0.5" class="slide on-dark relative overflow-hidden text-white">
    <div class="relative mx-auto grid w-full max-w-[1240px] items-center gap-12 px-5 sm:px-8 lg:grid-cols-[0.85fr_1.15fr] lg:gap-14">
        <div>
            <span class="eyebrow reveal">{t.eyebrow}</span>
            <h2 class="h-display reveal mt-5 text-[clamp(2rem,3.6vw,3rem)] text-white">
                {t.title} <span class="text-gradient-dark">{t.titleAccent}</span>
            </h2>
            <p class="reveal mt-4 max-w-[520px] text-lg leading-relaxed text-white/65">{t.lead}</p>

            <ul class="mt-8 space-y-1">
                {
                    t.features.map((f, i) => (
                        <li class="reveal flex gap-4 rounded-2xl p-3 transition-colors hover:bg-white/[0.04]">
                            <span class="icon-tile !h-11 !w-11 !rounded-xl">
                                <Icon name={featureIcons[i]} size={20} />
                            </span>
                            <div>
                                <strong class="block font-display text-[17px] font-semibold leading-snug tracking-tight text-white">{f.title}</strong>
                                <p class="mt-0.5 text-[14px] leading-relaxed text-white/60">{f.text}</p>
                            </div>
                        </li>
                    ))
                }
            </ul>
        </div>

        <!-- App window -->
        <div class="reveal relative [perspective:1600px]">
            <div class="absolute -inset-x-10 -bottom-10 top-10 rounded-[40px] bg-gradient-to-tr from-teal/40 via-cyan/20 to-lime/20 blur-3xl"></div>
            <div data-shape="frame" data-tilt class="glow-border relative origin-bottom overflow-hidden rounded-[20px] bg-navy-950 shadow-[0_60px_120px_-40px_rgba(0,0,0,0.8)]">
                <div class="flex items-center gap-3 border-b border-white/10 bg-navy-800/80 px-4 py-3">
                    <div class="flex gap-1.5">
                        <span class="h-3 w-3 rounded-full bg-white/15"></span>
                        <span class="h-3 w-3 rounded-full bg-white/15"></span>
                        <span class="h-3 w-3 rounded-full bg-white/15"></span>
                    </div>
                    <div class="mx-auto flex items-center gap-2 rounded-lg bg-black/30 px-4 py-1.5 font-mono text-[12px] text-white/55">
                        <Icon name="lock" size={12} /> app.dxter.ai
                    </div>
                    <div class="w-[52px]"></div>
                </div>
                <img src={`${base}img/platform-screen.webp`} alt="" width="1278" height="752" loading="lazy" class="block w-full" />
            </div>
        </div>
    </div>
</section>
