---
import Icon from "./Icon.astro";
import type { Dict } from "@/i18n/es";

interface Props {
    t: Dict["pricing"];
}

const { t } = Astro.props;

const tiers = [
    { users: "1–5", list: "50,00 €", offer: "25,00 €", volume: "—" },
    { users: "6–10", list: "45,00 €", offer: "22,50 €", volume: "−10 %" },
    { users: ">10", list: "40,00 €", offer: "20,00 €", volume: "−20 %" },
];
const packs = [
    { price: "50,00 €", unit: "0,50 €" },
    { price: "90,00 €", unit: "0,45 €" },
    { price: "200,00 €", unit: "0,40 €" },
    { price: "350,00 €", unit: "0,35 €", best: true },
];
const noteIcons = ["percent", "euro", "refresh"] as const;
---

<section id="precios" class="relative bg-white">
    <!-- Slide 1: the plan -->
    <div data-slide class="slide mx-auto max-w-[1240px] px-5 sm:px-8">
        <div class="mx-auto max-w-[820px] text-center">
            <span class="eyebrow reveal">{t.eyebrow}</span>
            <h2 class="h-display reveal mt-5 text-[clamp(2.1rem,4.2vw,3.4rem)] text-ink">
                {t.title} <span class="text-gradient">{t.titleAccent}</span>
            </h2>
            <p class="reveal mx-auto mt-4 max-w-[620px] text-lg leading-relaxed text-muted">{t.lead}</p>
        </div>

        <article class="dark-surface on-dark glow-border reveal relative mt-10 grid overflow-hidden rounded-[32px] p-7 sm:p-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-12">
            <div class="grid-bg pointer-events-none absolute inset-0 opacity-50 [mask-image:linear-gradient(to_bottom,#000,transparent_60%)]"></div>
            <div class="relative flex flex-col">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <span class="inline-flex items-center gap-2.5 font-mono text-xs uppercase tracking-[0.14em] text-cyan">
                        <Icon name="rocket" size={18} /> {t.offer}
                    </span>
                    <span class="rounded-full bg-lime px-3 py-1 font-display text-sm font-bold text-navy-900">−50 %</span>
                </div>
                <div class="mt-6 text-white/55">
                    {t.listPrice} <del class="ml-1 text-white/70">50 €</del>
                    <small class="text-sm"> {t.perUser}</small>
                </div>
                <div class="mt-1 flex items-end gap-3">
                    <span class="h-display text-[clamp(4rem,8vw,6rem)] !leading-[0.9] text-white"><span data-count="25" data-count-from="50">25</span>&nbsp;€</span>
                    <span class="pb-3 text-lg text-white/65">{t.perUser}</span>
                </div>
                <div class="mt-3 text-sm text-white/55">{t.taxes}</div>
                <div class="mt-1 text-sm text-white/55 [&_strong]:text-white/85" set:html={t.vat} />
                <a href="#contacto" data-boom class="btn btn-lime mt-8 w-full !min-h-[56px] !text-base lg:mt-auto">
                    {t.cta} <Icon name="arrow" size={18} strokeWidth={2} />
                </a>
            </div>

            <div class="relative mt-8 border-t border-white/10 pt-8 lg:mt-0 lg:border-l lg:border-t-0 lg:pl-12 lg:pt-0">
                <h3 class="font-mono text-xs uppercase tracking-[0.14em] text-white/50">{t.includedTitle}</h3>
                <ul class="mt-5 grid gap-x-6 gap-y-5 sm:grid-cols-2">
                    {
                        t.included.map((it) => (
                            <li class="flex gap-3">
                                <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-lime/15 text-lime">
                                    <Icon name="check" size={13} strokeWidth={2.6} />
                                </span>
                                <p class="text-[15px] leading-snug">
                                    <strong class="block font-semibold text-white">{it.title}</strong>
                                    <small class="text-[13px] text-white/55">{it.text}</small>
                                </p>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </article>
    </div>

    <!-- Slide 2: tiers, credit packs and conditions -->
    <div data-slide class="slide mx-auto max-w-[1240px] px-5 sm:px-8">
        <div class="grid min-w-0 gap-5 lg:grid-cols-2">
            <article class="card reveal p-7 sm:p-8">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <h3 class="font-display text-xl font-semibold tracking-tight text-ink">{t.usersTitle}</h3>
                        <p class="mt-1 text-[15px] text-muted">{t.usersLead}</p>
                    </div>
                    <span class="rounded-full bg-lime/30 px-3 py-1 font-display text-sm font-bold text-ink">−50 %</span>
                </div>
                <div class="mt-6 overflow-x-auto">
                    <table class="price-table w-full min-w-[300px] text-[15px]">
                        <thead>
                            <tr>{t.usersHead.map((h) => <th>{h}</th>)}</tr>
                        </thead>
                        <tbody>
                            {
                                tiers.map((t) => (
                                    <tr>
                                        <td class="font-medium text-ink">{t.users}</td>
                                        <td class="text-muted line-through decoration-muted/50">{t.list}</td>
                                        <td class="font-semibold text-teal">{t.offer}</td>
                                        <td class="text-muted">{t.volume}</td>
                                    </tr>
                                ))
                            }
                        </tbody>
                    </table>
                </div>
                <p class="mt-4 text-[13px] text-muted">{t.usersNote}</p>
            </article>

            <article class="card reveal p-7 sm:p-8">
                <h3 class="font-display text-xl font-semibold tracking-tight text-ink">{t.packsTitle}</h3>
                <p class="mt-1 text-[15px] text-muted">{t.packsLead}</p>
                <div class="mt-6 overflow-x-auto">
                    <table class="price-table w-full min-w-[280px] text-[15px]">
                        <thead>
                            <tr>{t.packsHead.map((h) => <th>{h}</th>)}</tr>
                        </thead>
                        <tbody>
                            {
                                packs.map((p, i) => (
                                    <tr>
                                        <td class={p.best ? "font-semibold text-ink" : "font-medium text-ink"}>{t.packs[i]}</td>
                                        <td class={p.best ? "font-semibold text-ink" : "text-muted"}>{p.price}</td>
                                        <td class={p.best ? "font-semibold text-teal" : "text-muted"}>{p.unit}</td>
                                    </tr>
                                ))
                            }
                        </tbody>
                    </table>
                </div>
                <p class="mt-4 text-[13px] text-muted">{t.packsNote}</p>
            </article>
        </div>

        <div class="mt-5 grid gap-4 md:grid-cols-3">
            {
                t.notes.map((n, i) => (
                    <div class="reveal flex gap-4 rounded-2xl border border-line bg-soft p-5">
                        <span class="icon-tile !h-10 !w-10 !rounded-xl">
                            <Icon name={noteIcons[i]} size={18} />
                        </span>
                        <p class="text-[15px] leading-snug">
                            <strong class="block font-semibold text-ink">{n.title}</strong>
                            <small class="text-[13px] text-muted">{n.text}</small>
                        </p>
                    </div>
                ))
            }
        </div>
    </div>
</section>
