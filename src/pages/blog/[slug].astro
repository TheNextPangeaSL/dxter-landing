---
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = new Date(post.data.date).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout
  title={`${post.data.title} – DxTER Blog`}
  description={post.data.description}
>
  <!-- Navbar -->
  <nav
    slot="nav"
    class="fixed top-0 inset-x-0 z-50 nav-blur border-b border-surface-300/60"
    id="navbar"
  >
    <div
      class="max-w-7xl mx-auto flex items-center justify-between px-6 sm:px-10 py-3.5"
    >
      <a href="/" class="flex items-center gap-2.5 group">
        <img
          src="/images/dxter-logo-noclaim-pos.png"
          alt="DxTER"
          class="h-9 w-auto"
        />
      </a>

      <div
        class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-500"
      >
        <a href="/#features" class="hover:text-dxter-700 transition-colors"
          >Features</a
        >
        <a href="/#use-cases" class="hover:text-dxter-700 transition-colors"
          >Use Cases</a
        >
        <a href="/#how-it-works" class="hover:text-dxter-700 transition-colors"
          >How it works</a
        >
        <a
          href="/blog"
          class="text-dxter-700 font-semibold transition-colors"
          >Blog</a
        >
        <a
          href="/#contact"
          class="btn-dxter !py-2.5 !px-5 !text-sm !rounded-lg">Contact Us</a
        >
        <a
          href="https://app.dxter.ai"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-dxter-outline !py-2.5 !px-5 !text-sm !rounded-lg"
        >
          Sign in
          <svg
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3-3l3-3m0 0l-3-3m3 3H9"
            ></path>
          </svg>
        </a>
      </div>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden flex items-center justify-center w-10 h-10 rounded-lg hover:bg-surface-100 transition-colors"
        aria-label="Toggle menu"
      >
        <svg
          class="w-5 h-5 text-slate-600"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
        </svg>
      </button>
    </div>

    <!-- Mobile menu -->
    <div
      id="mobile-menu"
      class="hidden md:hidden border-t border-surface-300/60 bg-white px-6 py-4"
    >
      <div class="flex flex-col gap-3 text-sm font-medium text-slate-600">
        <a href="/#features" class="py-2 hover:text-dxter-700 transition-colors"
          >Features</a
        >
        <a
          href="/#use-cases"
          class="py-2 hover:text-dxter-700 transition-colors">Use Cases</a
        >
        <a
          href="/#how-it-works"
          class="py-2 hover:text-dxter-700 transition-colors">How it works</a
        >
        <a href="/blog" class="py-2 text-dxter-700 font-semibold transition-colors"
          >Blog</a
        >
        <a href="/#contact" class="btn-dxter !text-sm mt-2">Contact Us</a>
        <a
          href="https://app.dxter.ai"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-dxter-outline !text-sm mt-1"
        >
          Sign in
          <svg
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3-3l3-3m0 0l-3-3m3 3H9"
            ></path>
          </svg>
        </a>
      </div>
    </div>
  </nav>

  <!-- Blog Post Content -->
  <article class="pt-28 pb-20">
    <div class="max-w-3xl mx-auto px-6 sm:px-10">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm text-slate-400 mb-8">
        <a href="/" class="hover:text-dxter-700 transition-colors">Home</a>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
        </svg>
        <a href="/blog" class="hover:text-dxter-700 transition-colors">Blog</a>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
        </svg>
        <span class="text-slate-500 truncate max-w-[200px]">{post.data.title}</span>
      </nav>

      <!-- Tags -->
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-5">
          {post.data.tags.map((tag: string) => (
            <span class="section-label !text-[0.7rem] !py-1 !px-3">{tag}</span>
          ))}
        </div>
      )}

      <!-- Title -->
      <h1
        class="text-3xl sm:text-4xl lg:text-[2.75rem] font-extrabold leading-tight tracking-tight text-slate-900 mb-6"
      >
        {post.data.title}
      </h1>

      <!-- Meta -->
      <div
        class="flex flex-wrap items-center gap-4 text-sm text-slate-400 mb-10 pb-10 border-b border-surface-300"
      >
        <div class="flex items-center gap-2">
          <div
            class="w-8 h-8 rounded-full bg-gradient-to-br from-dxter-500 to-dxter-700 flex items-center justify-center text-white text-xs font-bold"
          >
            {post.data.author.charAt(0)}
          </div>
          <span class="font-medium text-slate-600">{post.data.author}</span>
        </div>
        <span class="text-slate-300">·</span>
        <time datetime={post.data.date.toISOString()}>
          {formattedDate}
        </time>
      </div>

      <!-- Article Body -->
      <div class="prose prose-lg max-w-none">
        <Content />
      </div>

      <!-- Back to Blog -->
      <div class="mt-16 pt-10 border-t border-surface-300">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-sm font-semibold text-dxter-700 hover:text-dxter-800 transition-colors group"
        >
          <svg
            class="w-4 h-4 transition-transform group-hover:-translate-x-1"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"></path>
          </svg>
          Back to all articles
        </a>
      </div>
    </div>
  </article>
</Layout>

<style>
  /* Prose styles for Markdown content */
  .prose {
    color: #334155;
    line-height: 1.8;
  }

  .prose :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
    color: #0f172a;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
  }

  .prose :global(h3) {
    font-size: 1.25rem;
    font-weight: 600;
    color: #1e293b;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .prose :global(p) {
    margin-bottom: 1.25rem;
  }

  .prose :global(a) {
    color: #177b7d;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  .prose :global(a:hover) {
    color: #155e5f;
  }

  .prose :global(strong) {
    color: #0f172a;
    font-weight: 650;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .prose :global(ul) {
    list-style-type: disc;
  }

  .prose :global(ol) {
    list-style-type: decimal;
  }

  .prose :global(li) {
    margin-bottom: 0.5rem;
    padding-left: 0.25rem;
  }

  .prose :global(blockquote) {
    border-left: 4px solid #aeeae7;
    padding: 1rem 1.5rem;
    margin: 1.5rem 0;
    background: rgba(23, 123, 125, 0.04);
    border-radius: 0 12px 12px 0;
    color: #475569;
    font-style: italic;
  }

  .prose :global(code) {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.875em;
    background: #f1f5f9;
    padding: 0.15em 0.4em;
    border-radius: 4px;
    color: #177b7d;
  }

  .prose :global(pre) {
    background: #0f172a;
    color: #e2e8f0;
    padding: 1.25rem 1.5rem;
    border-radius: 12px;
    overflow-x: auto;
    margin: 1.5rem 0;
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
    color: inherit;
    font-size: inherit;
  }

  .prose :global(hr) {
    border: none;
    border-top: 1.5px solid #e5e7eb;
    margin: 2.5rem 0;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.9rem;
  }

  .prose :global(th) {
    text-align: left;
    font-weight: 600;
    color: #0f172a;
    padding: 0.75rem 1rem;
    border-bottom: 2px solid #e5e7eb;
    background: #f8fafc;
  }

  .prose :global(td) {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #f1f5f9;
    color: #475569;
  }

  .prose :global(tr:hover td) {
    background: #f8fafc;
  }

  .prose :global(img) {
    border-radius: 12px;
    margin: 2rem 0;
  }

  .prose :global(em) {
    color: #64748b;
  }
</style>

<script>
  // Mobile menu toggle
  const menuBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener("click", () => {
      mobileMenu.classList.toggle("hidden");
    });
    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        mobileMenu.classList.add("hidden");
      });
    });
  }

  // Navbar background on scroll
  const navbar = document.getElementById("navbar");
  if (navbar) {
    window.addEventListener("scroll", () => {
      if (window.scrollY > 20) {
        navbar.classList.add("shadow-sm");
      } else {
        navbar.classList.remove("shadow-sm");
      }
    });
  }
</script>
