---
import Layout from "@/layouts/Layout.astro";
import Faq from "@/components/Faq";
import WorkflowInfographic from "@/components/WorkflowInfographic.astro";
import GPCurveVisualization from "@/components/GPCurveVisualization.astro";
---

<Layout>
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- NAVBAR                                                            -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <nav
        slot="nav"
        class="fixed top-0 inset-x-0 z-50 nav-blur border-b border-surface-300/60"
        id="navbar"
    >
        <div
            class="max-w-7xl mx-auto flex items-center justify-between px-6 sm:px-10 py-3.5"
        >
            <!-- Logo -->
            <a href="#" class="flex items-center gap-2.5 group">
                <img
                    src={`${import.meta.env.BASE_URL}images/dxter-logo-noclaim-pos.png`}
                    alt="DxTER"
                    class="h-9 w-auto"
                />
            </a>

            <!-- Desktop Nav Links -->
            <div
                class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-500"
            >
                <a
                    href="#features"
                    class="hover:text-dxter-700 transition-colors">Features</a
                >
                <a
                    href="#use-cases"
                    class="hover:text-dxter-700 transition-colors">Use Cases</a
                >
                <a
                    href="#how-it-works"
                    class="hover:text-dxter-700 transition-colors"
                    >How it works</a
                >
                <a
                    href={`${import.meta.env.BASE_URL}blog`}
                    class="hover:text-dxter-700 transition-colors">Blog</a
                >
                <a href="#faq" class="hover:text-dxter-700 transition-colors"
                    >FAQ</a
                >
                <a
                    href="#contact"
                    class="btn-dxter !py-2.5 !px-5 !text-sm !rounded-lg"
                    >Contact Us</a
                >
                <a
                    href="https://app.dxter.ai"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-dxter-outline !py-2.5 !px-5 !text-sm !rounded-lg"
                >
                    Sign in
                    <svg
                        class="w-4 h-4"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2.5"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3-3l3-3m0 0l-3-3m3 3H9"
                        ></path></svg
                    >
                </a>
            </div>

            <!-- Mobile menu button -->
            <button
                id="mobile-menu-btn"
                class="md:hidden flex items-center justify-center w-10 h-10 rounded-lg hover:bg-surface-100 transition-colors"
                aria-label="Toggle menu"
            >
                <svg
                    class="w-5 h-5 text-slate-600"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
                </svg>
            </button>
        </div>

        <!-- Mobile menu -->
        <div
            id="mobile-menu"
            class="hidden md:hidden border-t border-surface-300/60 bg-white px-6 py-4"
        >
            <div class="flex flex-col gap-3 text-sm font-medium text-slate-600">
                <a
                    href="#features"
                    class="py-2 hover:text-dxter-700 transition-colors"
                    >Features</a
                >
                <a
                    href="#use-cases"
                    class="py-2 hover:text-dxter-700 transition-colors"
                    >Use Cases</a
                >
                <a
                    href="#how-it-works"
                    class="py-2 hover:text-dxter-700 transition-colors"
                    >How it works</a
                >
                <a
                    href={`${import.meta.env.BASE_URL}blog`}
                    class="py-2 hover:text-dxter-700 transition-colors">Blog</a
                >
                <a
                    href="#faq"
                    class="py-2 hover:text-dxter-700 transition-colors">FAQ</a
                >
                <a href="#contact" class="btn-dxter !text-sm mt-2">Contact Us</a
                >
                <a
                    href="https://app.dxter.ai"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-dxter-outline !text-sm mt-1"
                >
                    Sign in
                    <svg
                        class="w-4 h-4"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2.5"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3-3l3-3m0 0l-3-3m3 3H9"
                        ></path></svg
                    >
                </a>
            </div>
        </div>
    </nav>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- HERO SECTION                                                      -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <section
        class="relative min-h-[92vh] flex items-center pt-20 pb-16 overflow-hidden grid-pattern"
    >
        <!-- Decorative glows -->
        <div
            class="hero-glow w-[500px] h-[500px] bg-dxter-300 top-[-10%] right-[-5%]"
        >
        </div>
        <div
            class="hero-glow w-[400px] h-[400px] bg-dxter-400 bottom-[-10%] left-[-8%]"
        >
        </div>
        <div
            class="hero-glow w-[250px] h-[250px] bg-dxter-200 top-[30%] left-[20%]"
        >
        </div>

        <div class="max-w-7xl mx-auto px-6 sm:px-10 w-full">
            <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
                <!-- Left: Text -->
                <div class="max-w-xl">
                    <div class="section-label mb-6 animate-fade-in">
                        <svg
                            class="w-3.5 h-3.5"
                            fill="currentColor"
                            viewBox="0 0 20 20"
                            ><path
                                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
                            ></path></svg
                        >
                        Product Development Acceleration
                    </div>

                    <h1
                        class="text-4xl sm:text-5xl lg:text-[3.5rem] font-extrabold leading-[1.1] tracking-tight mb-6 animate-slide-up"
                    >
                        Smarter Experiments.<br />
                        <span class="gradient-text">Faster Discoveries.</span>
                    </h1>

                    <p
                        class="text-lg text-slate-500 leading-relaxed mb-10 animate-slide-up"
                        style="animation-delay:0.15s; opacity:0;"
                    >
                        DxTER is an AI-powered Design of Experiments platform
                        that reduces trial-and-error, optimizes resources, and
                        helps you reach breakthroughs with fewer experiments.
                    </p>

                    <div
                        class="flex flex-wrap gap-4 animate-slide-up"
                        style="animation-delay:0.3s; opacity:0;"
                    >
                        <a
                            href="https://app.dxter.ai"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="btn-dxter"
                        >
                            Go to App
                            <svg
                                class="w-4 h-4"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="2.5"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
                                ></path></svg
                            >
                        </a>
                        <a href="#how-it-works" class="btn-dxter-outline">
                            Learn More
                        </a>
                    </div>
                </div>

                <!-- Right: Animated Workflow Infographic -->
                <div
                    class="hidden lg:flex items-center justify-center relative animate-fade-in"
                    style="animation-delay:0.2s; opacity:0;"
                >
                    <WorkflowInfographic />
                </div>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- TRUST INDICATORS / QUICK STATS                                    -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <section class="py-12 bg-white border-y border-surface-300/60">
        <div class="max-w-7xl mx-auto px-6 sm:px-10">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
                <div class="reveal">
                    <div class="stat-number">-60%</div>
                    <div class="text-sm text-slate-500 mt-1">
                        Fewer experiments needed
                    </div>
                </div>
                <div class="reveal reveal-delay-1">
                    <div class="stat-number">3&times;</div>
                    <div class="text-sm text-slate-500 mt-1">
                        Faster time to discovery
                    </div>
                </div>
                <div class="reveal reveal-delay-2">
                    <div class="stat-number">100%</div>
                    <div class="text-sm text-slate-500 mt-1">
                        GDPR compliant
                    </div>
                </div>
                <div class="reveal reveal-delay-3">
                    <div class="stat-number">EU</div>
                    <div class="text-sm text-slate-500 mt-1">
                        European data centers
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- FEATURES (4 CARDS)                                                -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <section id="features" class="py-24 sm:py-32">
        <div class="max-w-7xl mx-auto px-6 sm:px-10">
            <div class="text-center mb-16 max-w-2xl mx-auto">
                <div class="section-label mx-auto mb-5 reveal">
                    <svg
                        class="w-3.5 h-3.5"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                        ><path
                            fill-rule="evenodd"
                            d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z"
                            clip-rule="evenodd"></path></svg
                    >
                    Key Features
                </div>
                <h2
                    class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4 reveal"
                >
                    Boost your experiments with <span class="gradient-text"
                        >DxTER</span
                    >
                </h2>
                <p class="text-slate-500 text-lg reveal">
                    Revolutionize your research with AI-powered experimentation.
                </p>
            </div>

            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
                <!-- Feature 1 -->
                <div class="feature-card reveal">
                    <div class="icon-box icon-box-light mb-5">
                        <svg
                            class="w-5 h-5"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"
                            ></path></svg
                        >
                    </div>
                    <h3 class="text-lg font-bold text-slate-800 mb-2">
                        Efficient Innovation
                    </h3>
                    <p class="text-sm text-slate-500 leading-relaxed">
                        Reduce trial-and-error and optimize resources with
                        intelligent experiment design.
                    </p>
                </div>

                <!-- Feature 2 -->
                <div class="feature-card reveal reveal-delay-1">
                    <div class="icon-box icon-box-light mb-5">
                        <svg
                            class="w-5 h-5"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456z"
                            ></path></svg
                        >
                    </div>
                    <h3 class="text-lg font-bold text-slate-800 mb-2">
                        AI-Driven DOE
                    </h3>
                    <p class="text-sm text-slate-500 leading-relaxed">
                        Automatically identify the best experiment settings
                        using advanced AI algorithms.
                    </p>
                </div>

                <!-- Feature 3 -->
                <div class="feature-card reveal reveal-delay-2">
                    <div class="icon-box icon-box-light mb-5">
                        <svg
                            class="w-5 h-5"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z"
                            ></path></svg
                        >
                    </div>
                    <h3 class="text-lg font-bold text-slate-800 mb-2">
                        Powerful Insights
                    </h3>
                    <p class="text-sm text-slate-500 leading-relaxed">
                        Gain in-depth knowledge of your data with intuitive
                        visualizations and analytics.
                    </p>
                </div>

                <!-- Feature 4 -->
                <div class="feature-card reveal reveal-delay-3">
                    <div class="icon-box icon-box-light mb-5">
                        <svg
                            class="w-5 h-5"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M15.59 14.37a6 6 0 01-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 006.16-12.12A14.98 14.98 0 009.631 8.41m5.96 5.96a14.926 14.926 0 01-5.841 2.58m-.119-8.54a6 6 0 00-7.381 5.84h4.8m2.58-5.84a14.927 14.927 0 00-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 01-2.448-2.448 14.9 14.9 0 01.06-.312m-2.24 2.39a4.493 4.493 0 00-1.757 4.306 4.493 4.493 0 004.306-1.758M16.5 9a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"
                            ></path></svg
                        >
                    </div>
                    <h3 class="text-lg font-bold text-slate-800 mb-2">
                        Fast Breakthroughs
                    </h3>
                    <p class="text-sm text-slate-500 leading-relaxed">
                        Fewer experiments to discover the future. Accelerate
                        your path to innovation.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- DETAILED FEATURES (3 BLOCKS)                                      -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <section class="py-24 sm:py-32 bg-white">
        <div class="max-w-7xl mx-auto px-6 sm:px-10">
            <div class="text-center mb-20 max-w-2xl mx-auto">
                <div class="section-label mx-auto mb-5 reveal">
                    Smart Design of eXperiments
                </div>
                <h2
                    class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4 reveal"
                >
                    Revolutionize your research <span class="gradient-text"
                        >with AI</span
                    >
                </h2>
            </div>

            <!-- Feature block 1 -->
            <div class="mb-24 reveal">
                <!-- Header: centered text -->
                <div class="text-center max-w-2xl mx-auto mb-10">
                    <div class="flex items-center justify-center gap-3 mb-4">
                        <div class="icon-box icon-box-teal">
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="2"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.517 0c.85.493 1.509 1.333 1.509 2.316V18"
                                ></path></svg
                            >
                        </div>
                        <span
                            class="text-xs font-bold uppercase tracking-wider text-dxter-700"
                            >Opportunities</span
                        >
                    </div>
                    <h3
                        class="text-2xl sm:text-3xl font-bold tracking-tight mb-4"
                    >
                        Identify knowledge gaps
                    </h3>
                    <p class="text-slate-500 leading-relaxed text-lg">
                        DxTER builds an intelligent predictive model from your
                        existing data. It learns what every untested combination
                        might yield — and how confident it is about each
                        prediction. Where confidence is low, there's
                        opportunity.
                    </p>
                </div>

                <!-- Chart: full width -->
                <div class="relative max-w-4xl mx-auto mb-10">
                    <GPCurveVisualization />
                    <div
                        class="absolute -inset-3 bg-gradient-to-br from-dxter-100 to-dxter-50 rounded-3xl -z-10 opacity-60"
                    >
                    </div>
                </div>

                <!-- Bullets: 3-column row -->
                <div class="grid sm:grid-cols-3 gap-6 max-w-4xl mx-auto">
                    <div class="flex items-start gap-3">
                        <svg
                            class="w-5 h-5 text-dxter-700 mt-0.5 flex-shrink-0"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2.5"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M4.5 12.75l6 6 9-13.5"></path></svg
                        >
                        <span class="text-sm text-slate-600"
                            >Spot unexplored regions where breakthroughs may
                            hide</span
                        >
                    </div>
                    <div class="flex items-start gap-3">
                        <svg
                            class="w-5 h-5 text-dxter-700 mt-0.5 flex-shrink-0"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2.5"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M4.5 12.75l6 6 9-13.5"></path></svg
                        >
                        <span class="text-sm text-slate-600"
                            >Quantify uncertainty — know exactly where you need
                            more data</span
                        >
                    </div>
                    <div class="flex items-start gap-3">
                        <svg
                            class="w-5 h-5 text-dxter-700 mt-0.5 flex-shrink-0"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2.5"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M4.5 12.75l6 6 9-13.5"></path></svg
                        >
                        <span class="text-sm text-slate-600"
                            >Each experiment sharpens the model — fewer runs,
                            better answers</span
                        >
                    </div>
                </div>
            </div>

            <!-- Feature block 2 -->
            <div
                class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center mb-24 reveal"
            >
                <div class="order-2 lg:order-1 relative">
                    <div class="glass rounded-2xl p-8 relative z-10">
                        <div class="space-y-4">
                            <div
                                class="flex items-center gap-3 p-3 bg-surface-100 rounded-xl border border-surface-300"
                            >
                                <div
                                    class="w-10 h-10 rounded-lg bg-dxter-700 flex items-center justify-center flex-shrink-0"
                                >
                                    <svg
                                        class="w-5 h-5 text-white"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        ><path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M2.25 12.75V12A2.25 2.25 0 014.5 9.75h15A2.25 2.25 0 0121.75 12v.75m-8.69-6.44l-2.12-2.12a1.5 1.5 0 00-1.061-.44H4.5A2.25 2.25 0 002.25 6v12a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9a2.25 2.25 0 00-2.25-2.25h-5.379a1.5 1.5 0 01-1.06-.44z"
                                        ></path></svg
                                    >
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div
                                        class="text-sm font-bold text-slate-800 truncate"
                                    >
                                        Polymer Optimization Q4
                                    </div>
                                    <div class="text-xs text-slate-400">
                                        12 experiments &middot; Updated 2h ago
                                    </div>
                                </div>
                                <div
                                    class="text-xs font-mono font-semibold text-dxter-700 bg-dxter-50 px-2 py-0.5 rounded-md"
                                >
                                    Active
                                </div>
                            </div>
                            <div
                                class="flex items-center gap-3 p-3 bg-surface-100 rounded-xl border border-surface-300"
                            >
                                <div
                                    class="w-10 h-10 rounded-lg bg-slate-200 flex items-center justify-center flex-shrink-0"
                                >
                                    <svg
                                        class="w-5 h-5 text-slate-500"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        ><path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
